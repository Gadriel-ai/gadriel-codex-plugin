#!/bin/sh
# gadriel: launcher bundled with the Gadriel Claude Code plugin.
#
# Claude Code puts this directory on the Bash tool's PATH and starts the MCP
# server through it, so every plugin component reaches the scanner the same
# way. It runs, in order of preference:
#
#   1. $GADRIEL_BIN, if set
#   2. a `gadriel` already on PATH (e.g. from `npm install -g gadriel`)
#   3. the pinned release below, downloaded once from registry.npmjs.org,
#      checked against the SHA-512 recorded here, and cached
#
# The pinned hashes are the npm registry's own `dist.integrity` values for
# @gadriel/cli-<platform>@<version>. A download that does not match is
# deleted, never run.
set -eu

GADRIEL_VERSION=1.7.0

die() {
  printf 'gadriel plugin: %s\n' "$*" >&2
  exit 1
}

if [ -n "${GADRIEL_BIN:-}" ]; then
  exec "$GADRIEL_BIN" "$@"
fi

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

# A `gadriel` on PATH other than this launcher (whose directory is on PATH too).
on_path=$(
  set -f
  IFS=:
  for d in $PATH; do
    [ -n "$d" ] && [ -x "$d/gadriel" ] && [ ! -d "$d/gadriel" ] || continue
    real=$(CDPATH= cd -- "$d" 2>/dev/null && pwd -P) || continue
    [ "$real" = "$self_dir" ] && continue
    printf '%s/gadriel' "$d"
    break
  done
)
if [ -n "$on_path" ]; then
  exec "$on_path" "$@"
fi

case $(uname -s) in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) die "no prebuilt gadriel for $(uname -s); install it (npm install -g gadriel) or set GADRIEL_BIN" ;;
esac
case $(uname -m) in
  arm64 | aarch64) cpu=arm64 ;;
  x86_64 | amd64) cpu=x64 ;;
  *) die "no prebuilt gadriel for $(uname -m); install it (npm install -g gadriel) or set GADRIEL_BIN" ;;
esac
case $os-$cpu in
  darwin-arm64) sha512=a24831b4c1b81b6bc4c8fb57d6ffc8d40e96542a75a73ee662ec37f0d3ea6ff42fe46b4ae95e19964d2fae9735c9fcabb260f131a7118eb8fa132ea1f3884c6d ;;
  darwin-x64) sha512=0af357f1f1eaceb7599cbd54bfe78324913ece8febf4a53254b67d353dcc859a25130890ce9c59b069e09b687497e365d384f032c1f131a450cbeeb886b58c3e ;;
  linux-x64) sha512=b93c363876da282fd71942647f5c19b2f1a38541d359fff0b3f79e79267e3ff812edc1ff7fef31b33e86e8fe3958ed7fa18124c583bd70d84844c6494ba58f38 ;;
  linux-arm64) sha512=ce54f666c46ec1761765ca3be51759daf11eaa4a84e6905bc66f1da2ad548b6017a96e3eaf714641b6eaf3564e183521efa79a381df2e7147a12e32adf82a9d1 ;;
esac

dir=${GADRIEL_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/gadriel-claude-plugin}/$GADRIEL_VERSION/$os-$cpu
bin=$dir/gadriel

sha512_of() {
  if command -v sha512sum >/dev/null 2>&1; then
    sha512sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 512 "$1" | cut -d' ' -f1
  else
    openssl dgst -sha512 -r "$1" | cut -d' ' -f1
  fi
}

release() {
  rm -rf "$tmp"
  rmdir "$lock" 2>/dev/null || true
}

fetch() {
  mkdir -p "$dir"
  lock=$dir/.lock
  tmp=$dir/.tmp.$$
  # The MCP server and a command can both start on first use: one downloads,
  # the others wait for it. A lock older than 10 minutes was left by a process
  # that died mid-download.
  tries=0
  until mkdir "$lock" 2>/dev/null; do
    [ -x "$bin" ] && return 0
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
      rmdir "$lock" 2>/dev/null || true
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -lt 1200 ] || die "timed out waiting for another download to finish ($lock)"
    sleep 0.5
  done
  trap release EXIT
  trap 'exit 1' HUP INT TERM
  if [ ! -x "$bin" ]; then
    url=https://registry.npmjs.org/@gadriel/cli-$os-$cpu/-/cli-$os-$cpu-$GADRIEL_VERSION.tgz
    printf 'gadriel plugin: downloading gadriel %s (%s-%s) from registry.npmjs.org\n' "$GADRIEL_VERSION" "$os" "$cpu" >&2
    mkdir "$tmp"
    curl -fsSL --retry 2 -o "$tmp/pkg.tgz" "$url" || die "download failed: $url"
    got=$(sha512_of "$tmp/pkg.tgz")
    [ "$got" = "$sha512" ] || die "checksum mismatch for $url, refusing to run it (expected sha512 $sha512, got $got)"
    tar -xzf "$tmp/pkg.tgz" -C "$tmp" package/bin/gadriel || die "unexpected package layout in $url"
    chmod 755 "$tmp/package/bin/gadriel"
    mv -f "$tmp/package/bin/gadriel" "$bin"
  fi
  # `exec` below replaces this process, so the EXIT trap would never fire.
  release
  trap - EXIT HUP INT TERM
}

if [ ! -x "$bin" ]; then
  # Hooks must never stall a turn on a download; they no-op until it exists.
  [ "${GADRIEL_PLUGIN_NO_DOWNLOAD:-}" = 1 ] && exit 0
  fetch
fi
exec "$bin" "$@"
